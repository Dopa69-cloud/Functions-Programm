import java.util.*;
class check
{
    public static void main(String[] args)
    {
        Scanner sc=new Scanner(System.in);
        System.out.println("Enter the string");
        String s=sc.nextLine();
        int x=s.length();
        int c=0;
        int p=0;
        for(int i=0;i<x;i++)
        {
            char ch=s.charAt(i);
            if(ch>='A' && ch<='Z')
            c++;
            if(ch>='a' && ch<='z')
            p++;
        }
        System.out.println("Capital "+c);
    System.out.println("Small "+p);
       }
}
