import java.util.*;

class Check
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);

        System.out.println("Enter the string");
        String s = sc.nextLine();

        int x = s.length();
        String result = "";

        for(int i = 0; i < x; i++)
        {
            char ch = s.charAt(i);

            if(ch >= 65 && ch <= 90)
                ch += 32;
            else if(ch >= 97 && ch <= 122)
                ch -= 32;

            result += ch;
        }

        System.out.println(result);
    }
}
